# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Neon Postgres connection string.
#  - App (Vercel): use the POOLED endpoint (host contains "-pooler").
#  - Migrations / pipeline (Node): the direct endpoint is fine.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# DeepSeek API key — used ONLY by the pipeline (analysis). The web app never calls an LLM.
# Put this in GitHub Actions secrets for the scheduled run; locally it lives here.
DEEPSEEK_API_KEY="sk-..."

# Shared password for the site gate. Auth middleware is OFF until this is set
# AND AUTH_ENABLED=true. Finalize after first deploy.
SITE_PASSWORD=""
AUTH_ENABLED="false"
